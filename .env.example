DEEPINFRA_API_KEY=
# MORPHO_DATA_DIR=./data
# BIND=127.0.0.1:8000
# CONTEXT_TOKEN_BUDGET=4000
# CONTEXT_SCORE_FLOOR=0   # pooled memories, beliefs and notes below this score stay out
# MAX_PROMPT_TOKENS=12000
# MAX_COMPLETION_TOKENS=2048
# LLM_TIMEOUT_SECONDS=120
# BACKGROUND_DAILY_TOKEN_BUDGET=100000
# IDLE_REFLECT_SECONDS=300
# REFLECT_EVERY_N_EVENTS=10
# CONSUMER_MAX_FAILURES=3
# WORKER_INPROCESS=true
JUDGE_MODEL=deepseek-ai/DeepSeek-V4-Flash
# Judge verdicts are a majority of this many votes (the judge is not deterministic).
# JUDGE_VOTES=3
# JUDGE_TEMPERATURE=0
# Model for the per-turn state clerk; empty means LLM_MODEL.
# CLERK_MODEL=
# OTLP export of traces and metrics (see README "Observability"); unset means none.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
